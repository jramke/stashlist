# Settings for `docker compose up`. Copy this file to .env and fill in what is marked.

# The address people reach the app at, with no trailing slash. Behind a reverse proxy with TLS, use https.
APP_NAME=Stashlist
APP_URL=http://localhost:8080
APP_PORT=8080

# A secret that signs sessions and encrypts data. Make one:
#   docker compose run --rm --no-deps -e APP_KEY=x app php artisan key:generate --show
# Keep it: losing it logs everyone out and makes encrypted values unreadable.
APP_KEY=

# Passwords for the database and the search engine. Make them long and random (openssl rand -hex 24).
DB_PASSWORD=
DB_ROOT_PASSWORD=
MEILISEARCH_MASTER_KEY=

# Who may register: closed (only the first account), invite (a link from `artisan stashlist:invite`) or open.
STASHLIST_REGISTRATION=closed

# Everything in the plans is capped; a self-hosted installation usually wants none of it.
STASHLIST_PLAN=unlimited

# Who sees Horizon (/horizon) and Pulse (/pulse): comma separated, a verified email address.
STASHLIST_ADMINS=

# Summaries, tags and search by meaning need an AI provider. Without a key they are off and search is by words.
STASHLIST_AI=true
STASHLIST_LLM=openai:gpt-5-mini
OPENAI_API_KEY=
# For another provider or a local model, see config/ai.php (ollama, openai-compatible, ...) and STASHLIST_LLM.

# For the privacy page.
STASHLIST_OPERATOR_NAME=
STASHLIST_OPERATOR_ADDRESS=
STASHLIST_OPERATOR_EMAIL=

# Sign in with GitHub or Google (optional): the buttons appear when both lines of a provider are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
