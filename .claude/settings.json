{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash",
                        "args": [
                            "-c",
                            "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format.sh\""
                        ],
                        "statusMessage": "Formatting changed files..."
                    }
                ]
            }
        ]
    }
}
